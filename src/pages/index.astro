---
import { getCollection } from "astro:content";

const posts = await getCollection("posts");

const recentPosts = posts
  .sort(
    (a, b) =>
      b.data.date.valueOf() - a.data.date.valueOf()
  )
  .slice(0, 5);
---

<!doctype html>

<html lang="zh-CN">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Natsume's Blog</title>

  <meta
    name="description"
    content="Natsume's personal blog"
  />

</head>

<body>

  <!-- ==================== -->
  <!-- 顶部导航 -->
  <!-- ==================== -->

  <header>

    <div class="header-inner">

      <a href="/" class="logo">
        Natsume's Blog
      </a>


      <nav>

        <a href="/">
          首页
        </a>

        <a href="/mobrei/">
          茂灵
        </a>

        <a href="/hobby/">
          兴趣
        </a>

        <a href="/essay/">
          随笔
        </a>

      </nav>

    </div>

  </header>



  <!-- ==================== -->
  <!-- 首页主体 -->
  <!-- ==================== -->

  <main>


    <!-- 欢迎区域 -->

    <section class="hero">

      <h1>
        Natsume's Blog
      </h1>

      <p>
        记录作品、兴趣，以及一些随手写下的东西。
      </p>

    </section>



    <!-- ==================== -->
    <!-- 分区 -->
    <!-- ==================== -->

    <section class="categories">

      <h2>
        分区
      </h2>


      <div class="category-grid">


        <!-- 茂灵 -->

        <a
          href="/mobrei/"
          class="category-card"
        >

          <h3>
            茂灵
          </h3>

          <p>
            作品与杂言
          </p>

        </a>



        <!-- 兴趣 -->

        <a
          href="/hobby/"
          class="category-card"
        >

          <h3>
            兴趣
          </h3>

          <p>
            感兴趣的事物与记录
          </p>

        </a>



        <!-- 随笔 -->

        <a
          href="/essay/"
          class="category-card"
        >

          <h3>
            随笔
          </h3>

          <p>
            日常想法与生活记录
          </p>

        </a>


      </div>

    </section>



    <!-- ==================== -->
    <!-- 最近文章 -->
    <!-- ==================== -->

    <section class="recent">

      <h2>
        最近文章
      </h2>


      {

        recentPosts.length === 0 ? (

          <p class="empty">
            暂时还没有文章。
          </p>

        ) : (

          recentPosts.map((post) => (

            <article>

              <div class="post-info">


                <div class="post-category">

                  {post.data.category}

                  {
                    post.data.type && (
                      <>
                        <span> · </span>
                        {post.data.type}
                      </>
                    )
                  }

                </div>


                <h3>

                  <a
                    href={`/posts/${post.id}/`}
                  >

                    {post.data.title}

                  </a>

                </h3>


                <p>

                  {post.data.description}

                </p>


              </div>


              <div class="post-date">

                {post.data.date.toLocaleDateString(
                  "zh-CN"
                )}

              </div>

            </article>

          ))

        )

      }

    </section>


  </main>



  <!-- ==================== -->
  <!-- 页脚 -->
  <!-- ==================== -->

  <footer>

    © 2026 Natsume's Blog

  </footer>


</body>

</html>



